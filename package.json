{
  "name": "pillcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && vite build"
  },
  "dependencies": { "pdf-lib": "^1.17.1" },
  "devDependencies": { "vite": "^7.1.0" }
}
