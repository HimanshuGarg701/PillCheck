{
  "name": "pillcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && vite build",
    "test:ios": "swift test --package-path ios --scratch-path tmp/swift-build"
  },
  "dependencies": {
    "nitro": "3.0.260903-beta"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
